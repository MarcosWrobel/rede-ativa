{
  "name": "rede-ativa-saas",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma Multi-Escola de Busca Ativa, Gestão de Frequência e Livro Oficial Digital de Atas Pedagógicas",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "node scripts/package_extension.cjs && next build",
    "start": "next start -p 3001",
    "test": "vitest run",
    "seed": "node scripts/seed.cjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:diff": "prisma migrate diff --from-url \"$DIRECT_URL\" --to-schema-datamodel prisma/schema.prisma --script",
    "db:migrate:baseline": "prisma migrate resolve --applied 0_init",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.4.0",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.9.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prisma": "^6.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
