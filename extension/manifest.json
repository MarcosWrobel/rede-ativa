{
  "manifest_version": 3,
  "name": "Sincronizador Leopoldina (Power BI & SERP)",
  "version": "1.5.0",
  "description": "Extrai dados de frequência do Power BI, fichas SERP e gerencia a confirmação automática de envio do WhatsApp Web para a Busca Ativa.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sincronizador Leopoldina"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://app.powerbi.com/*",
    "*://*.redeprotecao.seed.pr.gov.br/*",
    "*://redeprotecao.seed.pr.gov.br/*",
    "*://web.whatsapp.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://app.powerbi.com/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["*://app.powerbi.com/*"],
      "js": ["content.js"],
      "world": "ISOLATED",
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.redeprotecao.seed.pr.gov.br/*",
        "*://redeprotecao.seed.pr.gov.br/*"
      ],
      "js": ["serp-bridge.js"],
      "world": "MAIN",
      "all_frames": false,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.redeprotecao.seed.pr.gov.br/*",
        "*://redeprotecao.seed.pr.gov.br/*"
      ],
      "js": ["serp-content.js"],
      "world": "ISOLATED",
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["registro-bridge.js"],
      "world": "ISOLATED",
      "all_frames": false,
      "run_at": "document_start"
    },
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["whatsapp-content.js"],
      "css": ["whatsapp-focus.css"],
      "run_at": "document_idle"
    }
  ]
}
