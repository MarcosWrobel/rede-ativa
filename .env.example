# ==============================================================================
# REDE ATIVA SAAS — ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env.local (desenvolvimento) ou configure na Vercel (produção)
# cp .env.example .env.local
# ==============================================================================

# URL canônica da aplicação
# Em desenvolvimento local (npm run dev usa -p 3001): http://localhost:3001
# Em produção: https://busca-ativa-leopoldina.vercel.app (ou domínio próprio)
NEXTAUTH_URL="http://localhost:3001"

# Chaves secretas de sessão do Auth.js v5 / NextAuth (obrigatórias)
# Gere no terminal com: openssl rand -base64 32
AUTH_SECRET="gere-uma-chave-secreta-forte-com-openssl"
NEXTAUTH_SECRET="gere-uma-chave-secreta-forte-com-openssl"
AUTH_TRUST_HOST="true"

# Banco de dados PostgreSQL Serverless (Neon — AWS sa-east-1)
# DATABASE_URL: conexão via pooler (host -pooler) para consultas da aplicação
# DIRECT_URL: conexão direta (sem pooler) para sincronizações DDL do Prisma
# DICA: Para desenvolvimento seguro, crie sempre uma branch isolada no console do Neon
DATABASE_URL="postgresql://neondb_owner:senha@ep-xyz-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:senha@ep-xyz.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Super Administrador global da plataforma (e-mail institucional)
ADMIN_EMAIL="seu.nome@escola.pr.gov.br"

# ==============================================================================
# AUTENTICAÇÃO EM DESENVOLVIMENTO LOCAL (DEV AUTH)
# ==============================================================================
# Quando ativo fora de produção (NODE_ENV !== "production"), habilita login rápido
# na tela /login sem necessidade de configurar Google Cloud OAuth imediatamente.
ENABLE_DEV_AUTH="true"
NODE_ENV="development"

# ==============================================================================
# GOOGLE CLOUD OAUTH (Obrigatório em produção e para assinatura OIDC @escola)
# ==============================================================================
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"

# ==============================================================================
# INTEGRAÇÕES, IA, CHAVES DE EXTENSÃO E SEGREDOS
# ==============================================================================
# Chave da API Google Gemini para redação NRE de atas, modelos e classificação pedagógica
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Token secreto global opcional da Extensão Chrome (novas escolas usam syncTokenHash individual)
# Gere com: openssl rand -hex 24
SYNC_API_TOKEN="gere-um-token-aleatorio-forte-com-openssl-rand-hex-24"

# Segredo para autenticação de Webhooks do WhatsApp (retorna 503 se omitido)
WHATSAPP_WEBHOOK_SECRET=""

# Segredo para execução do cron job semanal na Vercel (/api/cron/weekly-digest)
CRON_SECRET="gere-um-segredo-forte-para-o-cron"
