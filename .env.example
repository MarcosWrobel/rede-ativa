# ==============================================================================
# REDE ATIVA SAAS — ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env.local (desenvolvimento) ou configure na Vercel (produção)
# cp .env.example .env.local
# ==============================================================================

# URL da aplicação
# Em desenvolvimento local: http://localhost:3000
# Em produção: https://busca-ativa-leopoldina.vercel.app (ou domínio próprio)
NEXTAUTH_URL="http://localhost:3000"

# Chave secreta de sessão do NextAuth (obrigatória)
# Gere no terminal com: openssl rand -base64 32
NEXTAUTH_SECRET="gere-uma-chave-secreta-forte-com-openssl"

# Banco de dados PostgreSQL Serverless (Neon / Supabase)
# DATABASE_URL: conexão via pooler (porta 6543 ou host -pooler) para consultas da aplicação
# DIRECT_URL: conexão direta (porta 5432) para migrações DDL e scripts Prisma
# DICA: Para desenvolvimento seguro, crie uma branch isolada no Neon console
DATABASE_URL="postgresql://neondb_owner:senha@ep-xyz-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:senha@ep-xyz.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Super Administrador da plataforma (e-mail institucional principal)
ADMIN_EMAIL="marcos.wrobel@escola.pr.gov.br"

# ==============================================================================
# AUTENTICAÇÃO EM DESENVOLVIMENTO LOCAL (DEV AUTH)
# ==============================================================================
# Quando ativo em desenvolvimento (NODE_ENV !== "production"), permite login simulado
# rápido na tela /login sem necessidade de configurar Google Cloud OAuth imediatamente.
ENABLE_DEV_AUTH="true"
NODE_ENV="development"

# ==============================================================================
# GOOGLE CLOUD OAUTH (Obrigatório para login de produção via @escola.pr.gov.br)
# ==============================================================================
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"

# ==============================================================================
# INTEGRAÇÕES, CHAVES DE EXTENSÃO E SEGREDOS
# ==============================================================================
# Chave da API Google Gemini para redação de atas, modelos e classificação pedagógica
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Token secreto exigido pela Extensão Chrome para sincronizar Power BI e SERP
# Gere com: openssl rand -hex 24
SYNC_API_TOKEN="gere-um-token-aleatorio-forte-com-openssl-rand-hex-24"

# Segredo para autenticação de Webhooks do WhatsApp (inativo por padrão)
WHATSAPP_WEBHOOK_SECRET="gere-um-segredo-forte-para-webhooks"

# Segredo para execução do cron job semanal na Vercel (/api/cron/weekly-digest)
CRON_SECRET="gere-um-segredo-forte-para-o-cron"
